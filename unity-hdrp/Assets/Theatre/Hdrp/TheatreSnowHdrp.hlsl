TEXTURE2D(_EvoSnowField);
SAMPLER(sampler_EvoSnowField);

// x, z: the world position of the grid's corner (column 0's low edge); y: one over the column's
// size in metres; w: the columns across x (z is the texture's other side, _EvoSnowCells.x).
float4 _EvoSnowGrid;
float4 _EvoSnowCells;

// x: the reference column density, J per cubic metre; y: the reference floor stock, J; z: how pale
// the bed goes at the reference; w: the least density ratio a column counts as for the shells' motes.
float4 _EvoSnowRef;

bool EvoRunSnow() { return _EvoLook2.y > 0.5; }

// The recorded snow at a world position: x the column's density, y the floor's stock. Bilinear
// between column centres. Zero outside the grid.
float2 EvoSnowAt(float3 positionWS)
{
    float2 cells = max(float2(1.0, 1.0), float2(_EvoSnowGrid.w, _EvoSnowCells.x));
    float2 index = (positionWS.xz - _EvoSnowGrid.xz) * _EvoSnowGrid.y;

    if (any(index < 0.0) || any(index > cells)) return float2(0.0, 0.0);

    // The texture's u runs along z and v along x: the dump's order is ix * cellsZ + iz, which
    // TheatreSkin uploads row by row, one row per ix.
    float2 uv = float2(index.y / cells.y, index.x / cells.x);

    return SAMPLE_TEXTURE2D_LOD(_EvoSnowField, sampler_EvoSnowField, uv, 0).rg;
}

// How many motes a shell's cell holds at a place, as a multiple of the shell's own share: the
// column's density over the reference, at least the least ratio (_EvoSnowRef.w), 1 without the
// run's fields.
float EvoSnowDensityRatio(float3 positionWS)
{
    if (!EvoRunSnow()) return 1.0;

    return max(_EvoSnowRef.w, EvoSnowAt(positionWS).x / max(1e-4, _EvoSnowRef.x));
}
// Whether a point is in the water: inside the box, under the waterline, and inside the tank's
// circle when there is one.
bool EvoInWater(float3 p, float3 low, float3 high, float4 tank)
{
    if (any(p < low) || any(p > high)) return false;

    if (tank.w > 0.5)
    {
        float2 o = p.xz - tank.xy;
        if (dot(o, o) > tank.z * tank.z) return false;
    }

    return true;
}

// The size of one pixel, in metres, at a distance along the ray: grows with distance for a
// perspective camera and is fixed for an orthographic one.
float EvoPixelMetres(float t)
{
    if (unity_OrthoParams.w > 0.5) return 2.0 * unity_OrthoParams.y / max(1.0, _ScreenParams.y);

    // abs: a projection rendering into a texture is flipped on some graphics APIs, which negates
    // this term and nothing about the pixel's size.
    return t * 2.0 / (max(1e-4, abs(UNITY_MATRIX_P[1][1])) * max(1.0, _ScreenParams.y));
}

            // One shell: the motes in the cells the ray crosses between tA and tB, in the frame
            // that falls with the snow (q = world + fall), so a mote is fixed in its cell there.
            // rgb: the motes' sunlight; a: the water's own light on them, as a brightness: the column's
            // colour at each mote's height, kept by the water between it and the eye (_MoteAmbient).
            float4 Shell(float3 origin, float3 dir, float tA, float tB, float4 shell, float radius,
                         float capPixels, float seed, float time)
            {
                float4 sum = float4(0.0, 0.0, 0.0, 0.0);
                if (tB <= tA) return sum;

                float cell = max(0.05, shell.z);

                // The lattice's frame: falling with the shaders' clock in the first batch, carried
                // by the run's water under the drift. A mote's world place is its lattice place
                // less this, so the water's displacement D is a frame offset of -D.
                bool drifting = _EvoSnowDrift.w > 0.5;
                float3 fall = drifting ? -_EvoSnowDrift.xyz : float3(0.0, _FallMetresPerSecond * time, 0.0);

                // Under the drift a cell holds its mote by the run's column density (item 4).
                bool runSnow = EvoRunSnow();
                float3 q0 = origin + fall;
                float3 start = q0 + dir * tA;

                float3 c = floor(start / cell);
                float3 safe = dir + step(abs(dir), 1e-6) * 1e-6;
                float3 ahead = step(0.0, safe);
                float3 stepC = ahead * 2.0 - 1.0;
                float3 tMax = tA + ((c + ahead) * cell - start) / safe;
                float3 tDelta = cell / abs(safe);

                [loop]
                for (int i = 0; i < 24; i++)
                {
                    float3 h = EvoHash3(c + seed);

                    // The share of cells with a mote, scaled by the run's column density at the
                    // cell (item 4); the first batch's share without the fields.
                    float share = shell.w * _ShareScale;
                    if (runSnow) share *= EvoSnowDensityRatio((c + 0.5) * cell - fall);
                    share = min(0.95, share);

                    if (h.x < share)
                    {
                        float3 place = EvoHash3(c * 1.31 + seed + 7.7);
                        float3 m = (c + 0.2 + 0.6 * place) * cell;

                        // A slow sway inside the cell, never out of it: 0.12 of a cell either way
                        // from a centre at least 0.2 of one in from every wall (under the drift a
                        // third of that, and in y too, so the snow tumbles a little in the water
                        // that carries it and never looks rigid).
                        if (drifting)
                        {
                            m += 0.04 * cell * sin(time * (0.13 + 0.11 * h.yzx) + 6.2831853 * h.zxy);
                        }
                        else
                        {
                            m.xz += 0.12 * cell * sin(time * (0.21 + 0.17 * h.yz) + 6.2831853 * h.zy);
                        }

                        float t = dot(m - q0, dir);

                        if (t > tA && t < tB)
                        {
                            float dist = length(q0 + dir * t - m);
                            float pixel = max(1e-5, EvoPixelMetres(t));

                            // At least most of a pixel, so a far mote is a speck and not a
                            // flicker; at most the cap, so a near one is never a blob.
                            float r = max(radius, 0.75 * pixel);
                            r = min(r, capPixels * pixel);

                            float cover = saturate((r - dist) / pixel + 0.5);

                            if (cover > 0.0)
                            {
                                float3 world = m - fall;

                                if (EvoInWater(world, _BoxMin.xyz, _BoxMax.xyz, _Tank))
                                {
                                    // A mote widened to a pixel keeps its own light, spread.
                                    float energy = min(1.0, (radius * radius) / (r * r));

                                    float gain = min(EvoCausticGain(world, time), 7.0);
                                    float3 kept = exp(-(_EvoAbsorb.xyz + _EvoAbsorb.w) * WaterPathMetres(origin, world));
                                    float3 light = EvoSunAt(world) * (0.3 + 0.7 * gain) * kept;

                                    sum.rgb += light * (cover * energy);
                                    float3 around = WaterColour(world.y) * kept;
                                    sum.a += cover * energy * dot(around, float3(0.2126, 0.7152, 0.0722));
                                }
                            }
                        }
                    }

                    float tNext = min(tMax.x, min(tMax.y, tMax.z));
                    if (tNext > tB) break;

                    if (tMax.x <= tMax.y && tMax.x <= tMax.z)
                    {
                        c.x += stepC.x;
                        tMax.x += tDelta.x;
                    }
                    else if (tMax.y <= tMax.z)
                    {
                        c.y += stepC.y;
                        tMax.y += tDelta.y;
                    }
                    else
                    {
                        c.z += stepC.z;
                        tMax.z += tDelta.z;
                    }
                }

                return sum;
            }


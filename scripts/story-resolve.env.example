# DaVinci Resolve settings for scripts/story-resolve.py, one machine's worth.
# Copy the lines you need into .env at the repository's root (gitignored; the commit hook refuses
# any *.env file), or set them in the environment, which wins over .env. KEY=value, no quotes
# needed, # starts a comment. Every key is optional; the value shown is the default.

# The project a story is built in. Empty: whatever project Resolve has open. When it names another
# project than the open one, the build stops unless it is run with --switch-project.
EVOSIM_RESOLVE_PROJECT=

# The bin every story goes under. Each build makes its own bin inside it, "<name> vK", holding a
# bin per run with that run's clips, the labels, the captions and the assets, beside the timeline
# of the same name.
EVOSIM_RESOLVE_BIN=Stories

# An empty timeline in the project to copy for every story. Style its subtitle track once
# (Inspector, Track: font, size, stroke, shadow, position) and every copy carries the style.
# Empty: a plain new timeline, captions in Resolve's default subtitle style.
EVOSIM_RESOLVE_TEMPLATE=

# The story timeline's size and rate. Set as custom timeline settings when the project differs.
EVOSIM_RESOLVE_WIDTH=3840
EVOSIM_RESOLVE_HEIGHT=2160
EVOSIM_RESOLVE_FPS=30

# The title card: a Text+ title of the story's title, for this many seconds; 0 leaves it out.
# Empty font: Resolve's own Text+ default. A named font must be installed for Resolve to use it
# (--check says whether it is).
EVOSIM_RESOLVE_TITLE_FONT=
EVOSIM_RESOLVE_TITLE_SECONDS=5

# The provenance label (FAITHFUL, COUSIN or UNVERIFIED, the run, the world's second) on V2; 0 = off.
EVOSIM_RESOLVE_LABEL=1

# Music under the film, played in order and cut at the film's end, faded over the last seconds.
# Paths relative to the repository's root or absolute, separated by semicolons.
EVOSIM_RESOLVE_MUSIC=
EVOSIM_RESOLVE_MUSIC_FADE=3

# A clip or still after the last scene, such as a closing card from assets/cards/.
EVOSIM_RESOLVE_END_CARD=

# Where Resolve's scripting module and library are, when not where the installer puts them.
# Windows defaults:
#   RESOLVE_SCRIPT_API=C:/ProgramData/Blackmagic Design/DaVinci Resolve/Support/Developer/Scripting
#   RESOLVE_SCRIPT_LIB=C:/Program Files/Blackmagic Design/DaVinci Resolve/fusionscript.dll

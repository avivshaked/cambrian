# Every per-machine setting and secret this project reads, with no values (or with the default).
# Copy this file to .env at the repository's root and fill in what you use. .env is gitignored, and the commit hook
# refuses it; this example is the one env file that is tracked. KEY=value, no quotes needed, # starts a comment.
# The environment wins over .env. Every key is optional: a tool that needs one and finds it missing says which key
# to add and what it is for.

# ── Images: scripts/leonardo-generate.py ────────────────────────────────────────────────────────────────────────
# The Leonardo.ai API key. Without it the script sends nothing and says so.
EVOSIM_LEONARDO_KEY=

# ── Narration voices: scripts/tts/google/ (audition.py, narrate.py) ─────────────────────────────────────────────
# The Gemini API key of the Google Cloud project the audition runs in. These two scripts read it from .env here, or
# from scripts/tts/google/.env.local, the place they used first.
GEMINI_API_KEY=

# ── Films in DaVinci Resolve: scripts/story-resolve.py and the create-story-video skill ─────────────────────────
# The project a story is built in. Empty: whatever project Resolve has open. When it names another project than the
# open one, the build stops unless it is run with --switch-project.
EVOSIM_RESOLVE_PROJECT=
# The bin every story goes under. Each build makes its own bin inside it, "<name> vK", holding a bin per run with
# that run's clips, the labels, the captions and the assets, beside the timeline of the same name.
EVOSIM_RESOLVE_BIN=Stories
# An empty timeline in the project to copy for every story. Style its subtitle track once (Inspector, Track: font,
# size, stroke, shadow, position) and every copy carries the style. Empty: a plain new timeline.
EVOSIM_RESOLVE_TEMPLATE=
# The story timeline's size and rate, set as custom timeline settings when the project differs.
EVOSIM_RESOLVE_WIDTH=3840
EVOSIM_RESOLVE_HEIGHT=2160
EVOSIM_RESOLVE_FPS=30
# The title card: a Text+ title of the story's title, for this many seconds; 0 leaves it out. Empty font: Resolve's
# own Text+ default. A named font must be installed for Resolve to use it (--check says whether it is).
EVOSIM_RESOLVE_TITLE_FONT=
EVOSIM_RESOLVE_TITLE_SECONDS=5
# The provenance label (FAITHFUL, COUSIN or UNVERIFIED, the run, the world's second) on V2; 0 = off.
EVOSIM_RESOLVE_LABEL=1
# Music under the film, played in order, cut at the film's end and faded over the last seconds. Paths relative to
# the repository's root or absolute, separated by semicolons.
EVOSIM_RESOLVE_MUSIC=
EVOSIM_RESOLVE_MUSIC_FADE=3
# A clip or still after the last scene, such as a closing card from assets/cards/.
EVOSIM_RESOLVE_END_CARD=
# Where Resolve's scripting module and library are, when not where the installer puts them. Windows defaults:
#   RESOLVE_SCRIPT_API=C:/ProgramData/Blackmagic Design/DaVinci Resolve/Support/Developer/Scripting
#   RESOLVE_SCRIPT_LIB=C:/Program Files/Blackmagic Design/DaVinci Resolve/fusionscript.dll
RESOLVE_SCRIPT_API=
RESOLVE_SCRIPT_LIB=

# ── Backups: scripts/backup/backup.ps1 (D260, logbook/specs/data-retention-and-backup.md) ───────────────────────
# 1Password references to the restic stores' password, never the password itself, e.g.
# op://<vault>/<item>/password. Without them restic asks for the password at the prompt.
EVOSIM_BACKUP_OP_LOCAL=
EVOSIM_BACKUP_OP_GDRIVE=
# The path to the Google OAuth client file of the rclone app, for reference. rclone itself holds the client in its
# own configuration (rclone config).
GDRIVE_OAUTH_CLIENT_JSON=

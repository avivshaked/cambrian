<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The nursery (D148, logbook/specs/nursery-general-build.md): brains evolved on fixed bodies in
    short tank episodes, run from a recipe file (rounds/nursery/), scored by a registered reward
    class and examined against control brains. Reads its recipe, the world config and a genome
    pool; writes only under its output directory and appends to the registry. Built with Unity's
    bundled SDK, as the farm is.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Evosim.Nursery</AssemblyName>
    <RootNamespace>Evosim.Nursery</RootNamespace>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evosim.Core\Evosim.Core.csproj" />
    <ProjectReference Include="..\Evosim.Dynamics\Evosim.Dynamics.csproj" />
    <ProjectReference Include="..\Evosim.Farm\Evosim.Farm.csproj" />
  </ItemGroup>

</Project>
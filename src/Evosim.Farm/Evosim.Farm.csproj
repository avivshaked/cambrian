<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The farm out of Unity (fable-propose-own-solver.md, stage 1): a console program that steps
    Core's World with Evosim.Dynamics instead of the Editor stepping it with PhysX. This project
    is work package I only — the environment binding, the run manifest and the markdown report.
    The loop, the metabolic handoff, the rows, the snapshots and the writers are other packages'
    files and are deliberately absent.

    net8.0 rather than netstandard2.1, for Evosim.Ledger's reason: this is a console app that
    never ships inside the Unity package, so it targets the SDK that actually runs it — the one
    Unity bundles (scripts/core-test.ps1). No dependency but Core and Dynamics; the whole point
    of the port is that nothing here needs an engine.

    InvariantGlobalization, like Evosim.Ledger: every number this writes into a report header,
    a footer or a manifest is formatted with InvariantCulture, and a process whose current
    culture cannot be anything else is one fewer way for a report to come out with commas for
    decimal points.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Evosim.Farm</AssemblyName>
    <RootNamespace>Evosim.Farm</RootNamespace>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evosim.Core\Evosim.Core.csproj" />
    <ProjectReference Include="..\Evosim.Dynamics\Evosim.Dynamics.csproj" />
  </ItemGroup>

</Project>

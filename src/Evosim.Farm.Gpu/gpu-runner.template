            _isGiant = new Scratch<int>(_acc, 16);
            _giantN = new Scratch<int>(_acc, WholeStep.GiantCap);
            _giantList = new Scratch<int>(_acc, WholeStep.GiantCap * WholeStep.GiantListCap);

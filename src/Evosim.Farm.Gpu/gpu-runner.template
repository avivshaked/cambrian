                    : _acc.LoadAutoGroupedKernel<Index1D, STopo, SConst, SPanels, SState, SDrive, SNeur, SBrain,
                        STrace, SGlob, SSph, SSph, SGrid, SWorld, SCfg>(WholeStep.Step__CI__);
                _streams[__CI__] = _acc.CreateStream();

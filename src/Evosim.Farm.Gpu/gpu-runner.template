            _leaf = new Col<float>(_acc, _stream, 1, 1);
            _cSource = new Col<int>(_acc, _stream, 1, 1); _cPortPart = new Col<int>(_acc, _stream, 1, 1);
            _cPortChannel = new Col<int>(_acc, _stream, 1, 1); _cPortIndex = new Col<int>(_acc, _stream, 1, 1);

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway probe for round 41c: develop every genome in a snapshot and count the pairs of
    developed parts whose oriented boxes intersect, excluding each part's own parent. Tests
    whether a multi-link body interpenetrates by construction, which would show up in PhysX
    as persistent contact pairs.

    Lives under scratch/ so src/Directory.Build.props does not redirect its output; bin/ and
    obj/ land beside this file. Built with Unity's bundled SDK, as scripts/core-test.ps1 and
    scripts/ledger.ps1 do.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Overlap</AssemblyName>
    <RootNamespace>Evosim.Scratch.Overlap</RootNamespace>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evosim.Core\Evosim.Core.csproj" />
  </ItemGroup>

</Project>

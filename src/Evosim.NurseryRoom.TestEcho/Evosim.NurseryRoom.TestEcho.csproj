<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A console program the room's tests copy into a folder whose path holds a space and start through the real launcher, by a forward-slash
    path and quoted arguments, as room.json's dotnet is started. It prints its arguments and the EVOSIM_ variables it was given.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

</Project>

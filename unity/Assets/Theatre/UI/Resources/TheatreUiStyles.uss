/* ============================================================
   TheatreUiStyles.uss — the theatre's interface, ported from
   design/canvas/theatre.uss (the design deliverable, 2026-09-12).

   THE DESIGN'S STYLESHEET IS THE AUTHORITY for every value here.
   This file is that file with four porting changes, each of them
   forced and each named where it happens:

     1. FONTS ARE NAMED IN EVERY RULE, not held in a custom
        property. design/SPEC.md §6 check 4 asks whether a USS
        variable can hold resource(...); nothing in this build
        could answer it without the Editor, and the spec's own
        fallback ("name the font asset directly in each rule")
        cannot fail. So --font-mono and its three siblings are
        gone and their resource() paths are written out. The four
        assets are generated by Evosim/Theatre/Build UI Fonts
        (Editor/TheatreUiFonts.cs) into UI/Resources/Fonts/.

     2. SHORTHANDS ARE WRITTEN LONG. padding: 10px var(--s4) is
        legal USS as far as anyone here knows, and a shorthand
        carrying a variable is one more thing that cannot be
        checked without a compile. Every padding, margin and
        border below is a longhand.

     3. THE WIDE STEP IS A CLASS, not a C# override of custom
        properties. UI Toolkit has no API for writing a custom
        property from C#; what it has is inline style and classes.
        .is-wide (>= 2240 px) and .is-wider (>= 3400 px) are set
        on the root by TheatreUi, and the rules that change are
        below under RESOLUTION. The type scale takes one step, at
        .is-wider only (the agent's ruling of 2026-09-13; item 5 of
        logbook/specs/theatre-ui-spec.md).

     4. A FEW CLASSES THE DESIGN DID NOT NEED are added at the
        bottom under PORT ADDITIONS: the solo mode's census, the
        thread-caveat provenance state (the sixth state, decided
        in logbook/specs/theatre-ui-spec.md item 2), and .is-gone,
        which is how a conditional element leaves the screen.

   Everything else — palette, type scale, spacing, geometry,
   every component — is the design's, value for value.

   Flexbox only. No gap, no grid, no float, no z-index, no
   shadows, no blurs, no gradients, no pseudo-elements.
   ============================================================ */

:root {
    /* --- palette -------------------------------------------------
       Status carries NO hue except --sig-alarm, and --sig-alarm is
       only ever a background plate behind near-black text, never
       text colour. Body colours (green, orange, grey, pink) are
       absent from the chrome by rule. ------------------------- */
    --ink-hi: rgb(237, 243, 245);
    --ink: rgb(166, 180, 186);
    --ink-lo: rgb(107, 120, 126);
    --ink-dim: rgb(72, 84, 90);

    --panel: rgba(5, 9, 11, 0.82);
    --panel-deep: rgba(5, 9, 11, 0.92);
    --plate: rgb(237, 243, 245);
    --plate-ink: rgb(5, 9, 11);

    --rule: rgba(237, 243, 245, 0.12);
    --rule-strong: rgba(237, 243, 245, 0.30);
    --track: rgba(237, 243, 245, 0.16);
    --row-hover: rgba(237, 243, 245, 0.05);

    --sig-alarm: rgb(255, 74, 43);

    /* --- type ----------------------------------------------------
       IBM Plex Mono for every number, identifier and hash; IBM Plex
       Sans for labels and prose; both SIL OFL. Weight is an asset,
       not a property: semibold appears on four elements only. */
    --t-micro: 10px;
    --t-sm: 11px;
    --t-md: 13px;
    --t-lg: 16px;
    --t-xl: 22px;
    --t-clock: 20px;

    /* --- spacing -------------------------------------------------- */
    --s1: 2px;
    --s2: 4px;
    --s3: 8px;
    --s4: 12px;
    --s5: 16px;
    --s6: 24px;
    --s7: 32px;

    /* --- geometry, settled against the mockup at 1920 ------------- */
    --radius: 2px;
    --strip-h: 40px;
    --bar-h: 68px;
    --panel-w: 280px;
    --inspector-w: 340px;
    --warnings-w: 430px;
    --popover-w: 460px;
    --numeric-w: 104px;
    --pad-edge: 16px;
    --census-top: 56px;
    --panel-top: 52px;
}

/* ---------- the screen ----------------------------------------
   One relative container filling the panel, with the six absolute
   children of DECLARATION ORDER inside it. It picks up no mouse
   input at all: a left-click in the water selects a creature and a
   right-drag looks around, and the interface must not stand in
   front of either. ------------------------------------------- */

.theatre-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---------- spacing convention -------------------------------
   Spacing is owned by the FOLLOWING sibling: margin-left in a row,
   margin-top in a column. USS has no :first-child, so a first child
   whose own class carries a margin is given .lead. --------------- */

.lead {
    margin-left: 0;
    margin-top: 0;
}

/* ---------- surfaces ------------------------------------------ */

.panel {
    background-color: var(--panel);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--rule);
    border-right-color: var(--rule);
    border-bottom-color: var(--rule);
    border-left-color: var(--rule);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    padding-top: var(--s4);
    padding-right: var(--s4);
    padding-bottom: var(--s4);
    padding-left: var(--s4);
    flex-direction: column;
}

.panel--strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--strip-h);
    flex-direction: row;
    align-items: center;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--pad-edge);
    padding-right: var(--pad-edge);
    background-color: var(--panel-deep);
    border-top-width: 0;
    border-right-width: 0;
    border-left-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

/* A broken invariant is the only loud state in the design. The
   strip keeps its ground and gains a 2px rule; the plate does the
   shouting. */
.panel--strip-alarm {
    border-bottom-width: 2px;
    border-bottom-color: var(--sig-alarm);
}

.panel--bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--bar-h);
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-deep);
    border-top-width: 1px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: var(--rule);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding-top: var(--s4);
    padding-bottom: var(--s4);
    padding-left: var(--pad-edge);
    padding-right: var(--pad-edge);
}

.panel--census {
    position: absolute;
    top: var(--census-top);
    right: var(--pad-edge);
    width: var(--panel-w);
}

/* No visual change. Present so the alarm census is addressable from
   C# and so the diverged row has a parent to hang off. */
.panel--census-alarm {
}

.panel--inspector {
    position: absolute;
    left: var(--pad-edge);
    bottom: 88px;
    width: var(--inspector-w);
}

.panel--inspector-empty {
}

.panel--inspector-dead {
}

.panel--inspector-unverifiable {
}

/* Grows DOWNWARD from the strip, on the left, over open water, so
   the census never moves when a warning appears or clears. */
.panel--warnings {
    position: absolute;
    top: var(--panel-top);
    left: var(--pad-edge);
    width: var(--warnings-w);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: var(--s4);
    padding-right: var(--s4);
}

/* Shares the warnings anchor deliberately. P shows the popover and
   HIDES the warnings; they are mutually exclusive, because the
   popover's content is a superset of the warning's. */
.panel--popover {
    position: absolute;
    top: var(--panel-top);
    left: var(--pad-edge);
    width: var(--popover-w);
    background-color: var(--panel-deep);
    border-top-color: var(--rule-strong);
    border-right-color: var(--rule-strong);
    border-bottom-color: var(--rule-strong);
    border-left-color: var(--rule-strong);
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
}

.section {
    flex-direction: column;
    border-top-width: 1px;
    border-top-color: var(--rule);
    padding-top: var(--s3);
    margin-top: 10px;
}

.section--flush {
    border-top-width: 0;
    padding-top: 0;
}

.section__title {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink-dim);
    letter-spacing: 1.4px;
    margin-bottom: var(--s3);
}

.rule-v {
    width: 1px;
    height: var(--s5);
    background-color: var(--rule);
    margin-left: 14px;
    margin-right: 14px;
}

/* ---------- identity, clock, pace ----------------------------- */

.ident {
    flex-direction: row;
    align-items: flex-end;
}

.ident__arm {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold SDF");
    font-size: var(--t-lg);
    color: var(--ink-hi);
    letter-spacing: 0.4px;
}

.ident__meta {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    margin-left: 14px;
}

.clock {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-clock);
    color: var(--ink-hi);
    letter-spacing: 0.5px;
    flex-direction: row;
    align-items: flex-end;
}

.pace {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    margin-right: var(--s5);
}

.pace--paused {
    color: var(--ink-hi);
    letter-spacing: 1px;
}

/* ---------- label / value ------------------------------------- */

.field {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.field__label {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    flex-grow: 1;
}

.field__value {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-md);
    color: var(--ink-hi);
    flex-direction: row;
    align-items: flex-end;
}

/* Fixed column. Four orders of magnitude pass through it without a
   single element moving. */
.numeric {
    -unity-text-align: middle-right;
    width: var(--numeric-w);
    justify-content: flex-end;
}

.numeric--wide {
    width: 132px;
}

.unit {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-dim);
    margin-left: 3px;
}

/* Cumulative reads quieter than instantaneous. */
.field--cumulative .field__value {
    color: var(--ink);
}

/* ---------- census rows --------------------------------------- */

.census-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.census-row:hover {
    background-color: var(--row-hover);
}

.census-row--hero {
    height: 34px;
    align-items: flex-end;
}

.census-row--hero .field__value {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold SDF");
    font-size: var(--t-xl);
}

/* Added to and removed from the tree, never hidden — a zero costs
   nothing. It is the last child of NOW, so under the following-
   sibling rule it brings its own 4px and disturbs nothing. */
.census-row--diverged {
    margin-top: var(--s2);
}

.census-row--diverged .field__label {
    color: var(--ink-hi);
}

.census-row--diverged .field__value {
    background-color: var(--sig-alarm);
    color: var(--plate-ink);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    padding-left: var(--s2);
    padding-right: var(--s2);
}

.census__cadence {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink-dim);
    letter-spacing: 0.5px;
    margin-top: 10px;
}

/* ---------- status markers ------------------------------------
   12x12. Shape and fill carry the state; hue carries nothing.
   All five are bordered boxes — no icon asset, no vector. -------- */

.marker {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
}

.marker--faithful {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink-lo);
    border-right-color: var(--ink-lo);
    border-bottom-color: var(--ink-lo);
    border-left-color: var(--ink-lo);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.marker--unverified {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink-hi);
    border-right-color: var(--ink-hi);
    border-bottom-color: var(--ink-hi);
    border-left-color: var(--ink-hi);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    overflow: hidden;
    flex-direction: row;
}

.marker__half {
    width: 50%;
    height: 100%;
    background-color: var(--ink-hi);
}

/* 9px box inside a 12px slot: rotation happens after layout, so the
   diamond cannot clip its neighbours. */
.marker--cousin {
    align-items: center;
    justify-content: center;
}

.marker__diamond {
    width: 9px;
    height: 9px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink-hi);
    border-right-color: var(--ink-hi);
    border-bottom-color: var(--ink-hi);
    border-left-color: var(--ink-hi);
    background-color: var(--ink-dim);
    rotate: 45deg;
}

.marker--diverged {
    background-color: var(--ink-hi);
    align-items: center;
    justify-content: center;
}

.marker__bar {
    width: 100%;
    height: 2px;
    background-color: var(--plate-ink);
}

.marker--unverifiable {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink-hi);
    border-right-color: var(--ink-hi);
    border-bottom-color: var(--ink-hi);
    border-left-color: var(--ink-hi);
}

.marker__quad {
    width: 50%;
    height: 50%;
    background-color: var(--ink-hi);
}

.marker--sm {
    width: 10px;
    height: 10px;
    margin-top: 3px;
}

.status {
    flex-direction: row;
    align-items: center;
}

.status__word {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    letter-spacing: 1.2px;
    color: var(--ink);
    margin-left: var(--s3);
}

.status--abnormal .status__word {
    color: var(--ink-hi);
}

/* ---------- plates -------------------------------------------- */

.plate {
    flex-direction: row;
    align-items: center;
    background-color: var(--sig-alarm);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: var(--s3);
    padding-right: var(--s3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.plate__mark {
    width: 10px;
    height: 10px;
    background-color: var(--plate-ink);
}

.plate__text {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold SDF");
    font-size: var(--t-md);
    color: var(--plate-ink);
    letter-spacing: 0.8px;
    margin-left: var(--s3);
}

/* Attention, not alarm: hue-free inverted plate. Used by SEEKING,
   which is a minutes-long modal state and must not read as normal
   play, but is not a failure. */
.plate--quiet {
    background-color: var(--plate);
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: var(--s3);
    padding-right: var(--s3);
    margin-left: 18px;
}

.plate--quiet .plate__text {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    letter-spacing: 1.2px;
    margin-left: 0;
}

/* ---------- badges, key hints --------------------------------- */

.badge {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--rule-strong);
    border-right-color: var(--rule-strong);
    border-bottom-color: var(--rule-strong);
    border-left-color: var(--rule-strong);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 5px;
    padding-right: 5px;
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink-lo);
    letter-spacing: 0.8px;
    margin-left: 14px;
}

/* Zero to two of these trail the cousin strip; each owns its own
   6px, so either can be absent. */
.badge--differs {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    border-top-color: var(--ink-hi);
    border-right-color: var(--ink-hi);
    border-bottom-color: var(--ink-hi);
    border-left-color: var(--ink-hi);
    color: var(--ink-hi);
    letter-spacing: 0;
    margin-left: 6px;
}

.badge--dead {
    color: var(--ink-hi);
}

.keyhint {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
}

.keyhint__key {
    min-width: 18px;
    height: var(--s5);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--rule-strong);
    border-right-color: var(--rule-strong);
    border-bottom-color: var(--rule-strong);
    border-left-color: var(--rule-strong);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink);
    -unity-text-align: middle-center;
    padding-left: var(--s2);
    padding-right: var(--s2);
}

.keyhint__key--wide {
    min-width: 36px;
}

.keyhint__label {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink-dim);
    letter-spacing: 0.6px;
    margin-left: 5px;
}

.keys {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* ---------- transport ----------------------------------------- */

.transport {
    flex-direction: row;
    align-items: center;
    width: 196px;
    flex-shrink: 0;
}

.transport__state {
    flex-direction: row;
    align-items: center;
}

.transport__word {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    letter-spacing: 1.2px;
    color: var(--ink-hi);
    margin-left: var(--s3);
}

/* The play triangle is painted with Painter2D (TheatreUi.PlayGlyph):
   U+25B6 is not in IBM Plex — checked against the three TTFs with
   fontTools on 2026-09-12 — so a text glyph was never an option. */
.glyph {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
}

/* The triangle is painted, so it cannot inherit a background the way the
   pause bars do; it takes its colour from here through resolvedStyle, which
   keeps the value in the stylesheet where every other value lives. */
.glyph--play {
    color: var(--ink-hi);
}

.glyph--pause {
    flex-direction: row;
    justify-content: space-between;
}

.glyph__bar {
    width: 3px;
    height: 12px;
    background-color: var(--ink-hi);
}

/* ---------- timeline ------------------------------------------ */

.timeline {
    flex-direction: column;
    flex-grow: 1;
    margin-left: 20px;
}

.timeline__track {
    flex-direction: row;
    height: 12px;
    align-items: stretch;
    position: relative;
}

.timeline__elapsed {
    background-color: var(--ink-lo);
    flex-shrink: 0;
}

/* Elapsed, but past the last recorded sample: same bar, dimmer. */
.timeline__elapsed--beyond {
    background-color: var(--ink-dim);
}

.timeline__recorded {
    background-color: var(--track);
    flex-grow: 1;
}

/* Unverified future. A dashed rule is not a USS border, so it is a
   row of 4x2 children — cheap, and it ports exactly. */
.timeline__beyond {
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.timeline__dash {
    width: 4px;
    height: 2px;
    background-color: var(--ink-dim);
    margin-left: 3px;
    flex-shrink: 0;
}

.timeline__head {
    width: 2px;
    flex-shrink: 0;
    background-color: var(--ink-hi);
}

.timeline__head--broken {
    width: 3px;
    background-color: var(--sig-alarm);
}

.timeline__mark {
    position: absolute;
    width: 1px;
    background-color: var(--rule-strong);
}

.timeline__mark--peak {
    top: -8px;
    height: var(--s3);
}

.timeline__mark--snapshot {
    top: 14px;
    width: 3px;
    height: 3px;
    background-color: var(--ink-dim);
}

.timeline__mark--record-end {
    top: -8px;
    height: 28px;
}

.timeline__mark--break {
    top: -8px;
    height: 28px;
    background-color: var(--sig-alarm);
}

.timeline__axis {
    flex-direction: row;
    position: relative;
    height: 14px;
    margin-top: var(--s3);
}

.timeline__tick {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink-dim);
}

/* Anchored ticks sit under their mark: an explicit left, set from
   C# as a percentage of the axis, with half the label's resolved
   width taken off as a negative margin once it has been measured. */
.timeline__tick--anchored {
    position: absolute;
    color: var(--ink);
}

.timeline__tick--loud {
    color: var(--ink-hi);
}

.timeline__tick--end {
    position: absolute;
    right: 0;
}

.timeline__legend {
    flex-direction: column;
    width: 250px;
    flex-shrink: 0;
    margin-left: 20px;
}

.seek-note {
    flex-direction: row;
    align-items: center;
}

.seek-note__text {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-micro);
    color: var(--ink-lo);
    letter-spacing: 0.5px;
    margin-left: 6px;
}

.seek-note__text--dim {
    color: var(--ink-dim);
    margin-left: 24px;
    margin-top: 3px;
}

/* The strip's own progress while seeking: 3px, full bleed, no
   radius. Minutes long, so it gets geometry, not a line of text. */
.seekbar {
    flex-direction: row;
    height: 3px;
    flex-shrink: 0;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
}

.timeline__seeking {
    background-color: var(--ink-hi);
    flex-shrink: 0;
}

.seekbar__remain {
    background-color: var(--track);
    flex-grow: 1;
}

/* ---------- warnings ------------------------------------------ */

.warning {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 6px;
}

.warning__body {
    flex-direction: column;
    margin-left: var(--s3);
    flex-shrink: 1;
}

.warning__title {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: 12px;
    color: var(--ink-hi);
}

.warning__detail {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    margin-top: var(--s1);
    white-space: normal;
}

/* ---------- provenance popover -------------------------------- */

.prov-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    border-top-width: 1px;
    border-top-color: var(--rule);
}

.prov-row__mark {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: 12px;
    color: var(--ink-hi);
    width: 14px;
}

.prov-row__mark--ok {
    color: var(--ink-lo);
}

.prov-row__label {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    width: 110px;
}

.prov-row__value {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: 12px;
    color: var(--ink-hi);
    flex-grow: 1;
}

.prov-row__value--ok {
    color: var(--ink);
}

.prov-row__recorded {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: 12px;
    color: var(--ink-lo);
}

.prov-row__recorded--ok {
    color: var(--ink-dim);
}

/* ---------- inspector ----------------------------------------- */

.inspector__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.inspector__id {
    -unity-font-definition: resource("Fonts/IBMPlexMono-SemiBold SDF");
    font-size: var(--t-lg);
    color: var(--ink-hi);
}

.inspector__id--dead {
    color: var(--ink-lo);
}

.guilds {
    flex-direction: row;
    margin-top: 10px;
}

.inspector__note {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    margin-top: 10px;
}

.ancestry__chain {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink);
    margin-top: var(--s2);
    white-space: normal;
}

.ancestry__founder {
    color: var(--ink-hi);
}

.ancestry__note {
    flex-direction: row;
    align-items: center;
    margin-top: var(--s2);
}

/* ---------- strike, without text-decoration -------------------
   USS has no text-decoration — confirmed against this Editor's
   UnityEngine.UIElementsModule, which carries every other property
   name in this file and not that one — and no pseudo-elements. So a
   strike is a 1px child laid over a relative container. ---------- */

.struck {
    position: relative;
    flex-direction: row;
    align-items: center;
}

.struck__rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background-color: var(--ink-lo);
}

.struck--after-chip {
    margin-left: 6px;
}

.struck--after-meta {
    margin-left: 14px;
}

/* ---------- prose --------------------------------------------- */

.prose {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular Prose SDF");
    font-size: 12px;
    color: var(--ink-lo);
    white-space: normal;
}

.prose--bright {
    color: var(--ink);
}

/* ---------- chips --------------------------------------------- */

.filter-chip {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--rule);
    border-right-color: var(--rule);
    border-bottom-color: var(--rule);
    border-left-color: var(--rule);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 7px;
    padding-right: 7px;
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink-lo);
    margin-left: 6px;
}

.filter-chip:hover {
    border-top-color: var(--rule-strong);
    border-right-color: var(--rule-strong);
    border-bottom-color: var(--rule-strong);
    border-left-color: var(--rule-strong);
    color: var(--ink);
}

.filter-chip--on {
    background-color: var(--plate);
    border-top-color: var(--plate);
    border-right-color: var(--plate);
    border-bottom-color: var(--plate);
    border-left-color: var(--plate);
    color: var(--plate-ink);
}

.filter-chip--off {
    color: var(--ink-dim);
}

/* ---------- chart frame (FORWARD-LOOKING) ---------------------
   Unused on purpose: the frame pass 3's charts will be painted
   into with Painter2D. Kept from the design rather than dropped so
   the port does not have to invent them later. ----------------- */

.chart-frame {
    flex-direction: column;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--rule);
    border-right-color: var(--rule);
    border-bottom-color: var(--rule);
    border-left-color: var(--rule);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    padding-top: var(--s4);
    padding-right: var(--s4);
    padding-bottom: var(--s4);
    padding-left: var(--s4);
}

.chart-frame__title {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink);
}

.chart-frame__plot {
    flex-grow: 1;
}

/* ============================================================
   PORT ADDITIONS — not in the design, and why
   ============================================================ */

/* How a conditional element leaves the screen. The design adds and
   removes the diverged row from the tree; everything else that
   comes and goes — a panel, a badge, the seekbar — is hidden with
   this, because rebuilding a panel per state would make the
   per-sample update the expensive thing on screen. */
.is-gone {
    display: none;
}

/* H. The whole interface, gone, so a picture carries the render and
   nothing else. */
.is-hidden {
    display: none;
}

/* The per-frame marker of the design's DECLARATION ORDER note. It
   has no rule there and none here, deliberately: it marks the four
   elements TheatreUi touches every frame, for a reader of the tree
   rather than for the eye. */
.is-per-frame {
}

/* The sixth provenance state (logbook/specs/theatre-ui-spec.md,
   item 2): a run whose physics ran on job worker threads, or whose
   manifest never said, is never shown as faithful — the shared
   world forks from itself after about 148,000 steps whatever this
   process does (D078). It borrows the half-filled ring, because
   what it means is the same shape of thing: the world may well be
   right and nothing here can check it. */
.marker--threaded {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ink-hi);
    border-right-color: var(--ink-hi);
    border-bottom-color: var(--ink-hi);
    border-left-color: var(--ink-hi);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    overflow: hidden;
    flex-direction: row;
}

/* The solo mode is the same strip with a different census (spec
   §8), and its census has more rows than a world's, so the panel
   sizes to its content instead of standing at a fixed height. The
   sensor rows are a column of .field rows under a .section. */
.panel--census-solo {
    width: 320px;
}

.census-row--sensor .field__label {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    color: var(--ink-dim);
}

/* The error state: the theatre could not open anything, and the
   only thing worth showing is why. */
.panel--error {
    position: absolute;
    top: var(--panel-top);
    left: var(--pad-edge);
    width: 720px;
}

.error__title {
    -unity-font-definition: resource("Fonts/IBMPlexSans-Regular SDF");
    font-size: var(--t-md);
    color: var(--ink-hi);
    margin-bottom: var(--s3);
}

.error__detail {
    -unity-font-definition: resource("Fonts/IBMPlexMono-Regular SDF");
    font-size: var(--t-sm);
    color: var(--ink);
    white-space: normal;
}

/* ============================================================
   RESOLUTION — one stylesheet, chrome fixed in pixels
   ------------------------------------------------------------
   PanelSettings at Constant Pixel Size, scale 1: the chrome is
   fixed in pixels and the water gains the area. The type scale
   never changes at any resolution.

   The design asks for one density step at panel width >= 2240,
   written from C#. UI Toolkit cannot write a custom property from
   C#, so the step is a class on the root instead — and a second
   one, .is-wider at >= 3400, which is the same three tokens at 1.5
   times (the owner's monitor is 3840 wide; logbook/specs/
   theatre-ui-spec.md item 5). At .is-wider the type tokens take the
   same 1.5 as well (below): 13 px type on a 3840-wide screen read
   too small in the first pictures, and a density step is not the
   uniform panel scaling the design rules out. Nothing else moves.

     .is-wide    strip-h 44, panel-w 320, pad-edge 20
     .is-wider   strip-h 66, panel-w 480, pad-edge 30
   ============================================================ */

.is-wide .panel--strip {
    height: 44px;
    padding-left: 20px;
    padding-right: 20px;
}

.is-wide .panel--bar {
    padding-left: 20px;
    padding-right: 20px;
}

.is-wide .panel--census {
    width: 320px;
    right: 20px;
    top: 60px;
}

.is-wide .panel--inspector {
    left: 20px;
}

.is-wide .panel--warnings {
    left: 20px;
    top: 56px;
}

.is-wide .panel--popover {
    left: 20px;
    top: 56px;
}

.is-wide .panel--error {
    left: 20px;
    top: 56px;
}

.is-wider .panel--strip {
    height: 66px;
    padding-left: 30px;
    padding-right: 30px;
}

.is-wider .panel--bar {
    padding-left: 30px;
    padding-right: 30px;
}

.is-wider .panel--census {
    width: 480px;
    right: 30px;
    top: 82px;
}

.is-wider .panel--inspector {
    left: 30px;
}

.is-wider .panel--warnings {
    left: 30px;
    top: 78px;
}

.is-wider .panel--popover {
    left: 30px;
    top: 78px;
}

.is-wider .panel--error {
    left: 30px;
    top: 78px;
}

.is-wider {
    --t-micro: 15px;
    --t-sm: 16px;
    --t-md: 20px;
    --t-lg: 24px;
    --t-xl: 33px;
    --t-clock: 30px;
}

/* The same six figures again, as font-size on every element that reads them.

   The block above does not reach anything. Redeclaring a custom property on
   .is-wider, which sits on theatre-root, leaves every consumer still resolving
   the :root value: at 3840 the third Editor run photographed 66px furniture
   around 13px type (2026-09-13). Why is not a thing this build could settle
   without an Editor, and the mechanism that does work is not in doubt, because
   the furniture above has used it since the step existed: a literal property
   under a .is-wider descendant selector, which beats the base rule on
   specificity and on order both.

   So these are the base rules' own selectors with .is-wider in front, one group
   per token, in the token block's order. Every use of a --t- token in this
   stylesheet is a font-size and all twenty-eight are here; if you add a rule
   that reads one, add its selector to the matching group. Change a size in the
   block above and change it here, in the same group. */

.is-wider .section__title,
.is-wider .census__cadence,
.is-wider .badge,
.is-wider .keyhint__key,
.is-wider .keyhint__label,
.is-wider .timeline__tick,
.is-wider .seek-note__text {
    font-size: 15px;
}

.is-wider .ident__meta,
.is-wider .pace,
.is-wider .field__label,
.is-wider .unit,
.is-wider .status__word,
.is-wider .transport__word,
.is-wider .warning__detail,
.is-wider .prov-row__label,
.is-wider .inspector__note,
.is-wider .ancestry__chain,
.is-wider .filter-chip,
.is-wider .chart-frame__title,
.is-wider .error__detail {
    font-size: 16px;
}

.is-wider .field__value,
.is-wider .plate__text,
.is-wider .error__title {
    font-size: 20px;
}

/* Two rules the base sheet gives a second class to, so they are repeated at
   their own specificity rather than left to lose to the group above. */
.is-wider .plate--quiet .plate__text {
    font-size: 16px;
}

.is-wider .ident__arm,
.is-wider .inspector__id {
    font-size: 24px;
}

.is-wider .census-row--hero .field__value {
    font-size: 33px;
}

.is-wider .clock {
    font-size: 30px;
}

/* The rhythm follows the type.

   Type at 1.5 inside rows at the base height is type that crowds: at 3840 the
   fourth Editor run put 20px values in 22px census rows, and the numbers rode
   over the labels' baselines (2026-09-13). Everything that spaces the type has
   to take the same step the type took, so these are 1.5 times the base value,
   rounded to the pixel, for every rule that sets a height, a width that holds
   type, a margin, a padding or an offset. The tokens behind them are the
   spacing scale --s1..--s7 (2, 4, 8, 12, 16, 24, 32), --bar-h 68, --numeric-w
   104, --inspector-w 340, --warnings-w 430 and --popover-w 460; the rest are
   literal in the base rules and are mirrored literally here.

   Same mechanism as the type step above, and for the same reason: a literal
   property under a .is-wider descendant selector, which beats the base rule on
   specificity and on order. Grouped by selector rather than by value, which is
   the one place this block departs from the type block's shape — a rule that
   sets four paddings wants them read together, and there are far more distinct
   values here than there are tokens.

   NOT stepped, deliberately: --radius (2px, a corner is a corner), every 1px
   hairline (.struck__rule, .rule-v's width, .timeline__mark's width), and the
   five values the owner already set at this step — the strip's 66, the census
   panel's 480 and its top of 82, pad-edge's 30 and --panel-top's 78. Order
   inside the block follows the stylesheet, so .panel's padding still loses to
   .panel--warnings' and .panel--popover's, as it does at the base size. */

.is-wider .panel {
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
}

.is-wider .panel--bar {
    height: 102px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.is-wider .panel--inspector {
    bottom: 132px;
    width: 510px;
}

.is-wider .panel--warnings {
    width: 645px;
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 18px;
    padding-right: 18px;
}

.is-wider .panel--popover {
    width: 690px;
    padding-top: 21px;
    padding-right: 21px;
    padding-bottom: 21px;
    padding-left: 21px;
}

.is-wider .section {
    padding-top: 12px;
    margin-top: 15px;
}

.is-wider .section__title {
    margin-bottom: 12px;
}

.is-wider .rule-v {
    height: 24px;
    margin-left: 21px;
    margin-right: 21px;
}

.is-wider .ident__meta {
    margin-left: 21px;
}

.is-wider .pace {
    margin-right: 24px;
}

.is-wider .field {
    height: 33px;
}

.is-wider .numeric {
    width: 156px;
}

.is-wider .numeric--wide {
    width: 198px;
}

.is-wider .unit {
    margin-left: 5px;
}

.is-wider .census-row {
    height: 33px;
}

.is-wider .census-row--hero {
    height: 51px;
}

.is-wider .census-row--diverged {
    margin-top: 6px;
}

.is-wider .census-row--diverged .field__value {
    padding-left: 6px;
    padding-right: 6px;
}

.is-wider .census__cadence {
    margin-top: 15px;
}

.is-wider .marker {
    width: 18px;
    height: 18px;
}

.is-wider .marker__diamond {
    width: 14px;
    height: 14px;
}

.is-wider .marker__bar {
    height: 3px;
}

.is-wider .marker--sm {
    width: 15px;
    height: 15px;
    margin-top: 5px;
}

.is-wider .status__word {
    margin-left: 12px;
}

.is-wider .plate {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
}

.is-wider .plate__mark {
    width: 15px;
    height: 15px;
}

.is-wider .plate__text {
    margin-left: 12px;
}

.is-wider .plate--quiet {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 27px;
}

.is-wider .badge {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 21px;
}

.is-wider .badge--differs {
    margin-left: 9px;
}

.is-wider .keyhint {
    margin-left: 21px;
}

.is-wider .keyhint__key {
    min-width: 27px;
    height: 24px;
    padding-left: 6px;
    padding-right: 6px;
}

.is-wider .keyhint__key--wide {
    min-width: 54px;
}

.is-wider .keyhint__label {
    margin-left: 8px;
}

.is-wider .transport {
    width: 294px;
}

.is-wider .transport__word {
    margin-left: 12px;
}

.is-wider .glyph {
    width: 18px;
    height: 18px;
}

.is-wider .glyph__bar {
    width: 5px;
    height: 18px;
}

.is-wider .timeline {
    margin-left: 30px;
}

.is-wider .timeline__track {
    height: 18px;
}

.is-wider .timeline__dash {
    width: 6px;
    height: 3px;
    margin-left: 5px;
}

.is-wider .timeline__head {
    width: 3px;
}

.is-wider .timeline__head--broken {
    width: 5px;
}

.is-wider .timeline__mark--peak {
    top: -12px;
    height: 12px;
}

.is-wider .timeline__mark--snapshot {
    top: 21px;
    width: 5px;
    height: 5px;
}

.is-wider .timeline__mark--record-end {
    top: -12px;
    height: 42px;
}

.is-wider .timeline__mark--break {
    top: -12px;
    height: 42px;
}

.is-wider .timeline__axis {
    height: 21px;
    margin-top: 12px;
}

.is-wider .timeline__legend {
    width: 375px;
    margin-left: 30px;
}

.is-wider .seek-note__text {
    margin-left: 9px;
}

.is-wider .seek-note__text--dim {
    margin-left: 36px;
    margin-top: 5px;
}

.is-wider .seekbar {
    height: 5px;
}

.is-wider .warning {
    margin-top: 9px;
}

.is-wider .warning__body {
    margin-left: 12px;
}

.is-wider .warning__detail {
    margin-top: 3px;
}

.is-wider .prov-row {
    height: 36px;
}

.is-wider .prov-row__mark {
    width: 21px;
}

.is-wider .prov-row__label {
    width: 165px;
}

.is-wider .inspector__head {
    margin-bottom: 15px;
}

.is-wider .guilds {
    margin-top: 15px;
}

.is-wider .inspector__note {
    margin-top: 15px;
}

.is-wider .ancestry__chain {
    margin-top: 6px;
}

.is-wider .ancestry__note {
    margin-top: 6px;
}

.is-wider .struck--after-chip {
    margin-left: 9px;
}

.is-wider .struck--after-meta {
    margin-left: 21px;
}

.is-wider .filter-chip {
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 11px;
    padding-right: 11px;
    margin-left: 9px;
}

.is-wider .chart-frame {
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
}

.is-wider .panel--census-solo {
    width: 480px;
}

.is-wider .panel--error {
    width: 1080px;
}

.is-wider .error__title {
    margin-bottom: 12px;
}
